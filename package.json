{
  "name": "music-downloader",
  "version": "1.0.35",
  "description": "多平台音乐下载器 - 支持网易云/QQ音乐/B站/酷狗/酷我/咪咕/汽水/5sing",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "vite build && node scripts/postbuild.js",
    "package": "vite build && node scripts/postbuild.js && electron-builder --config build/config.cjs --win --x64",
    "publish": "vite build && node scripts/postbuild.js && electron-builder --config build/config.cjs --publish always",
    "postinstall": "electron-builder install-app-deps",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint src/ test/",
    "smoke:asar": "node scripts/smoke-asar.js",
    "check:dead-deps": "node scripts/check-dead-deps.cjs",
    "check:icons": "node scripts/check-icons.cjs",
    "gen:icons": "node scripts/gen-icon.js",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run lint && npm test && npm run check:dead-deps && npm run check:icons && npm run build && npm run smoke:asar"
  },
  "keywords": [
    "music",
    "downloader",
    "electron"
  ],
  "author": "揽乐",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.6.3",
    "music-metadata": "^11.15.0",
    "NeteaseCloudMusicApi": "^4.32.0",
    "node-id3": "^0.2.9",
    "qq-music-api": "^1.1.2"
  },
  "overrides": {
    "qq-music-api": {
      "axios": "^0.34.0"
    },
    "music-metadata": "^11.15.0",
    "xml2js": "^0.6.2",
    "morgan": "^1.12.1",
    "on-headers": "^1.1.0",
    "tmp": "^0.2.7",
    "js-yaml": "^4.3.2",
    "ip-address": "^10.3.1"
  }
}
